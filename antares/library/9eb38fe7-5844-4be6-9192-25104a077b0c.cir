        <graph _id='2' uuid='9eb38fe7-5844-4be6-9192-25104a077b0c' name='Shifter 8-Bit' shortDesc='Schiebt einen 8-Bit-Wert nach bitweise nach links oder rechts' script='var d = parseInt(elem.input(&quot;D&quot;), &quot;16&quot;);
var left = elem.inputBit(&quot;F&quot;);
var cir = elem.inputBit(&quot;CIR&quot;);
var cil = elem.inputBit(&quot;CIL&quot;);

if (left) {
  elem.setOutput(&quot;O&quot;, (d &lt;&lt; 1).toString(&quot;16&quot;));
  elem.setOutputBit(&quot;COL&quot;, d &gt;= 128);
  elem.setOutputBit(&quot;COR&quot;, false);
} else {
  elem.setOutput(&quot;O&quot;, (d &gt;&gt; 1).toString(&quot;16&quot;));
  elem.setOutputBit(&quot;COL&quot;, false);
  elem.setOutputBit(&quot;COR&quot;, d % 2 == 1);
}' propDelay='40'>
