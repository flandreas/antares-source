        <graph _id='2' uuid='fa141b2b-57a3-43fc-8d9b-dac278ea74d0' name='ALU 4-Bit' shortDesc='Arithmetisch-Logische Einheit für 4-Bit-Operationen' script='var a = elem.inputWord(&quot;A&quot;);
var b = elem.inputWord(&quot;B&quot;);
var ci = parseInt(elem.input(&quot;CI&quot;));
switch(parseInt(elem.input(&quot;F0&quot;)) + 2*parseInt(elem.input(&quot;F1&quot;))) {
    case 0:
        var sum = a.toInt()+b.toInt()+ci;
        elem.setOutput(&quot;O&quot;, sum.toString(16));
        elem.setOutputBit(&quot;CO&quot;, sum &gt;= 16);
        break;
    case 1:
        elem.setOutputWord(&quot;O&quot;, a.and(b));
        elem.setOutputBit(&quot;CO&quot;, false);
        break;
    case 2:
        elem.setOutputWord(&quot;O&quot;, a);
        elem.setOutputBit(&quot;CO&quot;, false);
        break;
    case 3:
        elem.setOutputWord(&quot;O&quot;, a.not());
        elem.setOutputBit(&quot;CO&quot;, false);
        break;
}
elem.setOutputBit(&quot;Z&quot;, elem.outputWord(&quot;O&quot;).toInt() == 0);
elem.setOutputBit(&quot;N&quot;, elem.outputWord(&quot;O&quot;).bitAt(3).isSet());' propDelay='420'>
