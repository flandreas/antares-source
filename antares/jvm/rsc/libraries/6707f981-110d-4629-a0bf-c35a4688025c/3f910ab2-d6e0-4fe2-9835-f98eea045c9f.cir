  <graph>
    <graphStorable _id='1'>
      <model>
        <graph _id='2' type='digital' script='init {
	Q = 0
	&apos;!Q&apos; = 1
}

if (not &apos;!(PRE)&apos; and not &apos;!(CLR)&apos;) {
	Q = 1
	&apos;!Q&apos; = 1
	return
}
if (not &apos;!(PRE)&apos;) {
	Q = 1
	&apos;!Q&apos; = 0
	return
}
if (not &apos;!(CLR)&apos;) {
	Q = 0
	&apos;!Q&apos; = 1
	return
}

if (^C) {
	Q = D
	&apos;!Q&apos; = not D
}' propDelay='0' startupTime='30'>
          <elements>
            <circuitInOut _id='3' id='1' name='D' type='input' bitWidth='1'>
              <desc>
                <translation lang='de' text='Dateneingang'/>
                <translation lang='en' text='Data input'/>
              </desc>
            </circuitInOut>
            <circuitInOut _id='4' id='2' name='C' type='input' bitWidth='1'>
              <desc>
                <translation lang='de' text='Takteingang. Eine fallende Flanke speichert den Wert an D.'/>
                <translation lang='en' text='Clock input. A falling edge stores the value at D.'/>
              </desc>
            </circuitInOut>
            <nandGate _id='5' id='3' delay='PD / 7' inputCount='4'/>
