              <desc>
                <translation lang='de' text='Schreib-Enable. Daten an D werden geschrieben mit Signal 0.'/>
                <translation lang='en' text='Load enable. Data from D are loaded if signal is 0.'/>
              </desc>
            </circuitInOut>
            <circuitInOut _id='12' id='8' name='OE' type='input' bitWidth='1'>
              <desc>
                <translation lang='de' text='Ausgabe-Enable: Mit Signal 1 werden die gespeicherten Daten am Ausgang O ausgegeben. Mit Signal 0 erscheint am Ausgang O das Signal Z (hochohmig).'/>
                <translation lang='en' text='Output enable. With signal 1, the stored data appears at output O. With signal 0, output O is Z (high impedance).'/>
              </desc>
            </circuitInOut>
            <circuitInOut _id='13' id='9' name='CLR' type='input' bitWidth='1'>
              <desc>
                <translation lang='de' text='Asynchroner Löscheingang. Ein Signal 1 löscht die gespeicherten Daten.'/>
                <translation lang='en' text='Asynchronous clear. A 1 clears the stored data.'/>
              </desc>
            </circuitInOut>
            <circuitInOut _id='14' id='10' name='O' canBeUndefined='true' type='output' bitWidth='8'>
              <desc>
                <translation lang='de' text='Datenausgang. Z falls Eingang OE 0 ist.'/>
                <translation lang='en' text='Data output. Z if input OE is 0.'/>
              </desc>
