      <model>
        <graph _id='2' type='digital' script='init {
	Q = 0
	&apos;!Q&apos; = 1
}

if (^C) {
	if (R) {
		Q = 0
		&apos;!Q&apos; = 1
	} else if (S) {
		Q = 1
		&apos;!Q&apos; = 0
	}
}' propDelay='83' startupTime='45'>
