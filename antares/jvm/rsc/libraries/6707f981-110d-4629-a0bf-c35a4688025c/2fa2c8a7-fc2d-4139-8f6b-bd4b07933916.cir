      <model>
        <graph _id='2' type='digital' script='init {
	store data = 0
}

if (^T) {
	data = data &lt;&lt; 1
	data@0 = I

	O0 = data@0
	O1 = data@1
	O2 = data@2
	O3 = data@3
	Q = data@3
}

