      <model>
        <subGraphVertice _id='145' id='0' delay='0' uuid='2fa2c8a7-fc2d-4139-8f6b-bd4b07933916'>
          <desc>
            <translation lang='de' text='Schieberegister mit 4 Bit und Parallelausgabe. Schiebt die gespeicherten Daten bei ansteigender Taktflanke T eine Position weiter und speichert das Bit von Eingang I an der Position 0.'/>
            <translation lang='en' text='Shift register with 4 bits and parallel output. Shifts the stored data with a rising edge of T and stored the bit from input I in position 0.'/>
          </desc>
          <name>
            <translation lang='en' text='Shift Register Parallel-Out 4 Bit'/>
            <translation lang='de' text='Schieberegister Parallel-Out 4-Bit'/>
