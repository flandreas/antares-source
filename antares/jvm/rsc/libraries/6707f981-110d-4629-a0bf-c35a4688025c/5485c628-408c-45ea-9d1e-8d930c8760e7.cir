      <model>
        <subGraphVertice _id='89' id='0' delay='0' uuid='5485c628-408c-45ea-9d1e-8d930c8760e7'>
          <desc>
            <translation lang='de' text='Besteht aus 2 JK-Flipflops in Serie. Das Master-JK-Flipflop speichert den Eingabewert bei steigender Taktflanke, und das Slave-JK-Flipflop speichert danach den Ausgang des Masters bei fallender Taktflanke.'/>
            <translation lang='en' text='Consists of 2 JK flip-flops in series. The master JK flip-flop stores the input value on the rising clock edge, and the slave JK flip-flop stores the master&apos;s output on the falling clock edge.'/>
          </desc>
          <name>
            <translation lang='en' text='JK Master-Slave Flip-Flop'/>
            <translation lang='de' text='JK-Master\/Slave-Flipflop'/>
          </name>
          <ports>
            <subCircuitPort _id='74' portId='1' name='J' logic='positive' bitWidth='1' trigger='level' type='input' representation='binary'/>
            <subCircuitPort _id='77' portId='2' name='K' logic='positive' bitWidth='1' trigger='level' type='input' representation='binary'/>
            <subCircuitPort _id='80' portId='3' name='C' logic='positive' bitWidth='1' trigger='edge' type='input' representation='binary'/>
            <subCircuitPort _id='83' portId='4' name='Q' logic='positive' bitWidth='1' trigger='level' type='output' representation='binary' outputAnnotation='masterSlave'/>
            <subCircuitPort _id='86' portId='5' name='!Q' logic='negative' bitWidth='1' trigger='level' type='output' representation='binary' outputAnnotation='masterSlave'/>
          </ports>
        </subGraphVertice>
