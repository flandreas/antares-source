      <model>
        <graph _id='2' type='digital' script='init {
	Q = 0
	&apos;!Q&apos; = 1
}

if (PRE and CLR) {
	Q = 1
	&apos;!Q&apos; = 1
	return
}
if (PRE) {
	Q = 1
	&apos;!Q&apos; = 0
	return
}
if (CLR) {
	Q = 0
	&apos;!Q&apos; = 1
	return
}

if (^C) {
	Q = D
	&apos;!Q&apos; = not D
}' propDelay='0' startupTime='30'>
