      <model>
        <graph _id='2' type='digital' script='init {
	store signal
	signal = 0
}

if (CLR) {
	signal = 0
}

if (^CLR) {
	signal = 0
} else if (^C and not &apos;!(EN)&apos;) {
	signal = D
}

if (OE) {
	O = signal
} else {
	O = 0x?4
}' calculatedDelay='190'>
