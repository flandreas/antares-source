      <model>
        <graph _id='2' type='digital' script='if (F == 1) {
  O = 32768 * CIL or D &gt;&gt; 1
  COL = 0
  COR = D % 2 == 1
} else {
  O = D &lt;&lt; 1 or CIR
  COL = D &gt;= 32768
  COR = 0
}' propDelay='80' startupTime='30'>
