<metaGraph _id='0' dataVersion='2.3.0' manualContainer='true'>
  <graph>
    <graphStorable _id='1'>
      <model>
        <graph _id='2' type='digital' script='init {
	store fcStore
	for (i in 0 to 15) {
		fcStore[i] = 0
	}
}

if (ENC and ^CLK) {
	if (FC == 10 or FC &lt;= 4) {
		fcStore[FC] = C
	}
}

when (FA) {
	0 : A = fcStore[0]
	1 : A = fcStore[1]
	2 : A = fcStore[2]
	3 : A = fcStore[3]
	4 : A = fcStore[4]
	5 : A = 0
	6 : A = 1
	7 : A = 0xFFFF
	8 : A = 0x0FFF
	9 : A = 0x00FF
	10 : A = fcStore[10]
	else : A = 0x?16	
}

when (FB) {
	0 : B = fcStore[0]
	1 : B = fcStore[1]
	2 : B = fcStore[2]
	3 : B = fcStore[3]
	4 : B = fcStore[4]
	5 : B = 0
	6 : B = 1
	7 : B = 0xFFFF
	8 : B = 0x0FFF
	9 : B = 0x00FF
	10 : B = fcStore[10]
	else : B = 0x?16
}' propDelay='240'>
