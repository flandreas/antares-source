      <model>
        <graph _id='2' type='digital' script='var result

when (2 * F1 + F0) {
	0 : result = 1 * A + B
	1 : result = A and B
	2 : result = A
	3 : result = not A
}
O = result
CO = result &gt; 15
Z = result == 0
N = result@3' propDelay='420'>
