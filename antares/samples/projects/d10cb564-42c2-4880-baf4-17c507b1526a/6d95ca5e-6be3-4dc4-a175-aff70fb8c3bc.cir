                    <translation lang='en' text='Execute JNEG'/>
                  </name>
                  <desc>
                    <translation lang='en' text='Execute JNEG: Jump if AC &lt; 0'/>
                  </desc>
                  <steps/>
                </scenario>
                <scenario _id='256' id='16' condition='#5:3 == 44 or #5:3 == 45'>
                  <name>
