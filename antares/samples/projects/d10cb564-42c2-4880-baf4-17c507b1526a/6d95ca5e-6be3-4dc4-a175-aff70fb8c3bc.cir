                  </name>
                  <desc>
                    <translation lang='en' text='Execute JZER: Jump if AC = 0'/>
                  </desc>
                  <steps/>
                </scenario>
                <scenario _id='249' id='9' condition='#5:3 == 26'>
                  <name>
                    <translation lang='en' text='Execute JUMP'/>
                  </name>
                  <desc>
                    <translation lang='en' text='Execute JUMP: Jump always'/>
                  </desc>
                  <steps/>
