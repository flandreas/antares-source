                <scenario _id='246' id='6' condition='#5:3 == 15 or #5:3 == 16 or #5:3 == 17 or #5:3 == 18'>
                  <name>
                    <translation lang='en' text='Execute SUBD'/>
                  </name>
                  <desc>
                    <translation lang='en' text='Execute SUBD: AC = AC - memory'/>
