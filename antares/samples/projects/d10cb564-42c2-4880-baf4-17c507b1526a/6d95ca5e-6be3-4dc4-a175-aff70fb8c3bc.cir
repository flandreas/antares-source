                <scenario _id='250' id='10' condition='#5:3 == 27'>
                  <name>
                    <translation lang='en' text='Execute LOCO'/>
                  </name>
                  <desc>
                    <translation lang='en' text='Execute LOCO: Load constant'/>
                  </desc>
                  <steps/>
                </scenario>
                <scenario _id='251' id='11' condition='#5:3 == 31 or #5:3 == 32'>
                  <name>
                    <translation lang='en' text='Execute LODL'/>
                  </name>
                  <desc>
                    <translation lang='en' text='Execute LODL: Load local (AC := m[sp + x])'/>
                  </desc>
                  <steps/>
                </scenario>
                <scenario _id='252' id='12' condition='#5:3 == 33 or #5:3 == 34'>
                  <name>
                    <translation lang='en' text='Execute STOL'/>
                  </name>
                  <desc>
                    <translation lang='en' text='Execute STOL: Store local (m[x + SP] := AC)'/>
                  </desc>
                  <steps/>
                </scenario>
                <scenario _id='253' id='13' condition='#5:3 == 36 or #5:3 == 37'>
                  <name>
                    <translation lang='en' text='Execute ADDL'/>
                  </name>
                  <desc>
                    <translation lang='en' text='Execute ADDL: Add local (AC := AC + m[SP + x])'/>
                  </desc>
                  <steps/>
                </scenario>
                <scenario _id='254' id='14' condition='#5:3 == 38 or #5:3 == 39'>
                  <name>
                    <translation lang='en' text='Execute SUBL'/>
                  </name>
                  <desc>
                    <translation lang='en' text='Execute SUBL: Subtract local (AC := AC - m[SP + x])'/>
                  </desc>
                  <steps/>
                </scenario>
                <scenario _id='255' id='15' condition='#5:3 == 42 or #5:3 == 43'>
