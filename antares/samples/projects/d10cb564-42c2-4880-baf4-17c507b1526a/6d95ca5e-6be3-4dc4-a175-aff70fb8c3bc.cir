                <scenario _id='245' id='5' condition='#5:3 == 12 or #5:3 == 13 or #5:3 == 14'>
                  <name>
                    <translation lang='en' text='Execute ADDD'/>
                  </name>
                  <desc>
                    <translation lang='en' text='Execute ADDD: AC := AC + memory'/>
                  </desc>
                  <steps/>
