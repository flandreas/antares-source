<metaGraph _id='0' appVersion='1.31.0' manualContainer='true'>
  <graph>
    <graphStorable _id='1'>
      <model>
        <graph _id='2' type='digital' script='var result

when (2 * F1 + F0) {
	0 : {
		O = (1 * A + B + CI) % 2
		CO = (1 * A + B + CI) &gt;= 2
	}
	1 : {
		O = A and B
		CO = 0
	}
	2 : {
		O = A
		CO = 0
	}
	3 : {
		O = not A
		CO = 0
	}
}' propDelay='100' startupTime='60'>
