var b = elem.inputWord(&quot;B&quot;);
switch(parseInt(elem.input(&quot;F&quot;))) {
    case 0:
        var sum = a.toInt()+b.toInt();
        elem.setOutput(&quot;O&quot;, sum.toString(16));
        break;
    case 1:
        elem.setOutputWord(&quot;O&quot;, a.and(b));
        break;
    case 2:
        elem.setOutputWord(&quot;O&quot;, a);
        break;
    case 3:
        elem.setOutputWord(&quot;O&quot;, a.not());
        break;
}
elem.setOutputBit(&quot;Z&quot;, elem.outputWord(&quot;O&quot;).toInt() == 0);
elem.setOutputBit(&quot;N&quot;, elem.outputWord(&quot;O&quot;).bitAt(15).isSet());' propDelay='1800'>
