      <model>
        <graph _id='2' script='var result

when (F0 + 2 * F1) {
	0 : {
		O = (A + B + CI) % 2
		CO = (A + B + CI) &gt;= 2
	}
	1 : {
		O = A and B
		CO = 0
	}
	2 : {
		O = A
		CO = 0
	}
	3 : {
		O = not A
		CO = 0
	}
}' propDelay='100'>
