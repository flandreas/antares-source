<metaGraph _id='0'>
  <graph>
    <graphStorable _id='1'>
      <model>
        <graph _id='2' script='var a = parseInt(elem.input(&quot;A&quot;));
var b = parseInt(elem.input(&quot;B&quot;));
var ci = parseInt(elem.input(&quot;CI&quot;));
switch(parseInt(elem.input(&quot;F0&quot;)) + 2*parseInt(elem.input(&quot;F1&quot;))) {
    case 0:
        elem.setOutput(&quot;O&quot;, ((a+b+ci) % 2).toString());
        elem.setOutputBit(&quot;CO&quot;, a+b+ci &gt;= 2);
        break;
    case 1:
        elem.setOutputBit(&quot;O&quot;, a==1 &amp;&amp; b==1);
        elem.setOutputBit(&quot;CO&quot;, false);
        break;
    case 2:
        elem.setOutput(&quot;O&quot;, a.toString());
        elem.setOutputBit(&quot;CO&quot;, false);
        break;
    case 3:
        elem.setOutputBit(&quot;O&quot;, a != 1);
        elem.setOutputBit(&quot;CO&quot;, false);
        break;
}' propDelay='100'>
