      <model>
        <graph _id='2' script='var f = elem.inputWord(&quot;F&quot;).toInt();
var d = elem.inputWord(&quot;D&quot;);

switch(f) {
  case 0:
    elem.setOutputWord(&quot;O&quot;, d);
    break;
  case 1:
    elem.setOutputWord(&quot;O&quot;, d.shiftRight(1));
    break;
  case 2:
    elem.setOutputWord(&quot;O&quot;, d.shiftLeft(1));
    break; 
}' propDelay='160'>
