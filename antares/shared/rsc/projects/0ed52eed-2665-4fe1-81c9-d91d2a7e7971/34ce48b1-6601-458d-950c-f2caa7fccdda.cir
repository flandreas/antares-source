        <subGraphVertice _id='273' id='0' delay='0' uuid='34ce48b1-6601-458d-950c-f2caa7fccdda'>
          <desc>
            <translation lang='de' text='Enthält für alle Hex-Ziffern 0..F eine Taste, die in Zeilen R und Spalten C angeordnet sind. Die Ausgänge Rx und Cx geben 1 aus, wenn die Taste an ihrem Kreuzungspunkt gedrückt wird.'/>
            <translation lang='en' text='Contains a key for all hex digits 0..F, arranged in rows R and columns C. The outputs Rx and Cx output 1 when the key at its intersection is pressed.'/>
          </desc>
          <name>
            <translation lang='de' text='Tastatur'/>
