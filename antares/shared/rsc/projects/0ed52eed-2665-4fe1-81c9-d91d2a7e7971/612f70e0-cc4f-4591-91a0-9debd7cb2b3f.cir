                <rectangle id='41' style='subsystem' filled='true' stroked='true' x='38.5' y='-308.0' w='311.5' h='539.0' vAlign='top'>
                  <text>
                    <translation lang='de' text='Dekodierung'/>
                    <translation lang='en' text='Deccoding Unit'/>
                  </text>
                  <desc>
                    <translation lang='de' text='Dekodiert die Position der gedrückten Taste in die anzuzeigende Hexadezimal-Ziffer, die in der entsprechenden Speicherzelle des ROM-Bausteins gespeichert ist.'/>
                    <translation lang='en' text='Decodes the position of the pressed key into the hexadecimal digit to be displayed, which is stored in the corresponding memory cell of the ROM component.'/>
                  </desc>
                </rectangle>
              </component>
