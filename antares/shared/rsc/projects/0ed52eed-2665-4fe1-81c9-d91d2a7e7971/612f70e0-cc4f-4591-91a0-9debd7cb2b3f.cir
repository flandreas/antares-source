                  <desc>
                    <translation lang='de' text='Wandelt die Position der gedrückten Taste in eine Adresse für die Dekodierungs-Stufe um.'/>
                    <translation lang='en' text='Converts the position of the pressed key into an address for the decoding stage.'/>
                  </desc>
                </rectangle>
              </component>
