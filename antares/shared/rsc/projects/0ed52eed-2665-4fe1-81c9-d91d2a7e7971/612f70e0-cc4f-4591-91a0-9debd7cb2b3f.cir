                  </text>
                  <desc>
                    <translation lang='de' text='Zeigt die Ziffer der gedrückten Taste in einer 7-Segment-Anzeige an.'/>
                    <translation lang='en' text='Shows the number of the pressed key in a 7-segment display.'/>
                  </desc>
                </rectangle>
