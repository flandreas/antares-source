<metaGraph _id='0' manualContainer='true'>
  <graph>
    <graphStorable _id='1'>
      <model>
        <graph _id='2' type='digital' script='init {
	store data
	data = 0
	O = data
}

if (CLR) {
	data = 0
	O = data
	return
}

if (not EN) {
	return
}

if (^C) {
	data = data + 1
	O = data 
}

' purelyScripted='true'>
