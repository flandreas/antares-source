<metaGraph _id='0'>
  <graph>
    <graphStorable _id='1'>
      <model>
        <graph _id='2' script='var sum = (1 * A) + (1 * B) + CI

var max = 0
for (i in 1 to BW) {
	max = max &lt;&lt; 1 or 1
}

S = sum
CO = sum &gt; max' purelyScripted='true'>
          <elements>
            <circuitInOut _id='3' id='1' name='A' type='input' bitWidth='BW'>
              <desc>
                <translation lang='de' text='Erster Summand.'/>
                <translation lang='en' text='First summand.'/>
              </desc>
            </circuitInOut>
            <circuitInOut _id='4' id='2' name='B' type='input' bitWidth='BW'>
              <desc>
                <translation lang='de' text='Zweiter Summand.'/>
                <translation lang='en' text='Second summand.'/>
              </desc>
            </circuitInOut>
            <circuitInOut _id='5' id='3' name='S' type='output' bitWidth='BW'>
              <desc>
                <translation lang='de' text='Summe'/>
                <translation lang='en' text='Sum'/>
              </desc>
            </circuitInOut>
            <circuitInOut _id='6' id='4' name='CI' type='input' bitWidth='1'>
              <desc>
                <translation lang='de' text='Eingehender Übertrag.'/>
                <translation lang='en' text='Carry In'/>
              </desc>
            </circuitInOut>
            <circuitInOut _id='7' id='5' name='CO' type='output' bitWidth='1'>
              <desc>
                <translation lang='de' text='Ausgehender Übertrag'/>
                <translation lang='en' text='Carry Out'/>
              </desc>
            </circuitInOut>
          </elements>
        </graph>
      </model>
