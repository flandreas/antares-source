<metaGraph _id='0'>
  <graph>
    <graphStorable _id='1'>
      <model>
        <graph _id='2' script='if (F == 0) {
	O = I &lt;&lt; L
} else {
	O = I &gt;&gt; L
}' purelyScripted='true' propDelay='20'>
          <elements>
            <circuitInOut _id='3' id='1' name='I' type='input' bitWidth='BW'>
              <desc>
                <translation lang='de' text='Dateineingang. Erhält die Bits, die geschoben werden.'/>
                <translation lang='en' text='Data Input. Receives the bit to be shifted.'/>
              </desc>
            </circuitInOut>
            <circuitInOut _id='4' id='2' name='O' type='output' bitWidth='BW'>
              <desc>
                <translation lang='de' text='Datenausgang. Gibt die geschobenen Bits aus.'/>
                <translation lang='en' text='Data Output. Outputs the shifted bits.'/>
              </desc>
            </circuitInOut>
            <circuitInOut _id='5' id='3' name='L' type='input' bitWidth='log2(BW)'>
              <desc>
                <translation lang='en' text='Length. Specified the number of positions to shift I.'/>
                <translation lang='de' text='Länge. Gibt die Anzahl Positionen an, um die die Bits von I verschoben werden.'/>
              </desc>
            </circuitInOut>
            <circuitInOut _id='6' id='4' name='F' type='input' bitWidth='1'>
              <desc>
                <translation lang='de' text='Funktion: 0 schiebt nach links, 1 schiebt nach rechts.'/>
                <translation lang='en' text='Function: 0 shifts to the left, 1 shifts to the right.'/>
              </desc>
            </circuitInOut>
          </elements>
        </graph>
      </model>
